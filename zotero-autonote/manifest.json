{
  "manifest_version": 2,
  "name": "Zotero AutoNote",
  "version": "0.2.8",
  "description": "Automatically creates AI notes for Zotero items with PDFs, with manual generation for any regular item.",
  "author": "Zotero AutoNote contributors",
  "homepage_url": "https://github.com/tianlanvera/zotero-autonote",
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "applications": {
    "zotero": {
      "id": "zotero-autonote@example.com",
      "update_url": "https://raw.githubusercontent.com/tianlanvera/zotero-autonote/main/updates.json",
      "strict_min_version": "10.0",
      "strict_max_version": "10.0.*"
    }
  }
}
